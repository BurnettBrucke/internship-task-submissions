# =========================================================
# PostgreSQL
# =========================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=jobs_db


# =========================================================
# Gateway Service
# =========================================================

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

JWT_DEMO_USERNAME=demo
JWT_DEMO_PASSWORD=change_me

PROCESSING_BASE_URL=http://processing-service:8001
PROCESSING_TIMEOUT_SECONDS=5

# Shared secret used for Gateway -> Processing authentication
PROCESSING_SERVICE_TOKEN=change_me


# =========================================================
# Processing Service
# =========================================================

PROCESSING_HOST=0.0.0.0
PROCESSING_PORT=8001

DATABASE_URL=postgresql+asyncpg://postgres:change_me@localhost:5432/jobs_db

REDIS_URL=redis://localhost:6379/0